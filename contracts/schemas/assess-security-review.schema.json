{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "avd-assess-security-review/v1: the security review map (security-review.json)",
  "description": "Contract C20's fourth document, generated by avd-assess from security-review.yaml and checked fresh by its CI. It indexes what a security reviewer needs to approve deploying AVD with the family's repos: claims about what each repo does, each with its evidence at a pinned commit and a standing (run, guarded, built, designed); what the operator still owns; the reviewer's questions; a short summary per repo of what it can touch; and the gaps found. It cross-links the pillars and references in map.json and index.json and restates none of them. Evidence in another repo carries its pinned url; evidence in avd-assess carries only its path, which a reader resolves at the avd-assess commit it pinned. Optional and additive: a reader that doesn't know a field ignores it. Read by the avd-ops security page.",
  "type": "object",
  "required": ["schema", "checked", "pins", "maturity", "standards", "areas", "operator", "checklist", "threats", "gaps"],
  "additionalProperties": false,
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "repo": {"enum": ["avd-landing-zone", "avd-current-state", "avd-assess", "avd-second-brain", "avd-swarm", "avd-ops"]},
    "cite": {"type": "string", "pattern": "^(ref|obs|gap):[A-Za-z0-9._:#-]+$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evidence": {
      "type": "object",
      "required": ["repo", "path", "kind"],
      "additionalProperties": false,
      "properties": {
        "repo": {"$ref": "#/$defs/repo"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+(#[A-Za-z0-9._-]+)?$"},
        "kind": {"enum": ["lesson", "run", "test", "ci", "code", "license", "decision", "doc"]},
        "url": {"type": "string", "pattern": "^https://github\\.com/avd-ops/[a-z-]+/blob/[0-9a-f]{40}/"}
      }
    },
    "see": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "avd-assess-security-review/v1"},
    "checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "pins": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/repo"},
      "additionalProperties": {"$ref": "#/$defs/sha"}
    },
    "maturity": {
      "type": "object",
      "required": ["source", "repos"],
      "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/evidence"},
        "repos": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/repo"},
          "additionalProperties": {"enum": ["proven", "pre-beta", "design"]}
        }
      }
    },
    "standards": {
      "type": "object",
      "required": ["method", "pillars", "references"],
      "additionalProperties": false,
      "properties": {
        "method": {"type": "string"},
        "scope": {"$ref": "#/$defs/cite"},
        "pillars": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
        "references": {"type": "array", "items": {"$ref": "#/$defs/cite"}}
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "pillars", "claims"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "title": {"type": "string"},
          "pillars": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "repo", "says", "standing", "evidence"],
              "additionalProperties": false,
              "properties": {
                "id": {"$ref": "#/$defs/slug"},
                "repo": {"$ref": "#/$defs/repo"},
                "says": {"type": "string", "minLength": 10},
                "standing": {"enum": ["run", "guarded", "built", "designed"]},
                "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
                "note": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "operator": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "says", "see"],
        "additionalProperties": false,
        "properties": {"id": {"$ref": "#/$defs/slug"}, "says": {"type": "string"}, "see": {"$ref": "#/$defs/see"}}
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ask", "see"],
        "additionalProperties": false,
        "properties": {"id": {"$ref": "#/$defs/slug"}, "ask": {"type": "string"}, "see": {"$ref": "#/$defs/see"}}
      }
    },
    "threats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "touches", "risks", "limits", "formal"],
        "additionalProperties": false,
        "properties": {
          "repo": {"$ref": "#/$defs/repo"},
          "touches": {"type": "string"},
          "risks": {"type": "array", "items": {"type": "string"}},
          "limits": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
          "formal": {"oneOf": [{"const": "none"}, {"$ref": "#/$defs/evidence"}]}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repos", "says"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "repos": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repo"}},
          "says": {"type": "string"},
          "issue": {"type": "string", "pattern": "^https://github\\.com/avd-ops/[a-z-]+/issues/\\d+$"}
        }
      }
    }
  }
}
