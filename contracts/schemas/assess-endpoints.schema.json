{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "avd-assess-endpoints/v1: the AVD endpoint map (endpoints.json)",
  "description": "Contract C20's fourth document, generated by avd-assess from endpoints.yaml and checked fresh by its CI. One row per endpoint a family tool probes or reports as not tested, each pointing at the pinned Learn claim that lists it; Microsoft's page stays the source of truth, and addresses and ranges are never restated (a row names the service tag instead). Rows add where a probe means something (probeFrom), whether a tool's overall verdict counts a failure (verdict) and the kind of target. Readers vendor this file at an avd-assess commit with its SHA-256, never fetch it at run time, ignore fields they don't know, and treat a probe from a vantage not in probeFrom as unknown. Renaming or removing a row bumps version.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "cloud",
    "readAt",
    "lists",
    "endpoints",
    "views"
  ],
  "additionalProperties": false,
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"
    },
    "claim": {
      "type": "string",
      "pattern": "^ref:[a-z0-9-]+#[a-z0-9-]+$"
    },
    "vantage": {
      "enum": [
        "browser",
        "device",
        "host"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "claim",
        "url",
        "pin"
      ],
      "additionalProperties": false,
      "properties": {
        "claim": {
          "$ref": "#/$defs/claim"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "pin": {
          "type": "string",
          "description": "The reference's immutable pin, as references/ writes it (a Learn page's git_commit_id and updated_at)."
        }
      }
    },
    "idList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "avd-assess-endpoints/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "cloud": {
      "enum": [
        "azure-public"
      ],
      "description": "One map per cloud; other clouds are an extension point."
    },
    "readAt": {
      "type": "object",
      "description": "Reference id to the Learn git_commit_id the rows were read at.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "minProperties": 1
    },
    "lists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "claim",
          "dimension",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "$ref": "#/$defs/claim"
          },
          "dimension": {
            "$ref": "#/$defs/slug",
            "description": "The map row (dimensions.yaml) this list measures."
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "list",
          "kind",
          "protocol",
          "port",
          "purpose",
          "verdict",
          "probeFrom",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "list": {
            "$ref": "#/$defs/slug"
          },
          "kind": {
            "enum": [
              "fqdn",
              "wildcard",
              "range",
              "address"
            ]
          },
          "host": {
            "type": "string",
            "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
            "description": "The name, for fqdn and wildcard rows only. Never an address."
          },
          "protocol": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "purpose": {
            "enum": [
              "sign-in",
              "service",
              "connection-center",
              "relay",
              "certificates",
              "links-and-docs",
              "troubleshooting",
              "telemetry",
              "client-updates",
              "agent",
              "activation",
              "marketplace",
              "portal-support",
              "platform"
            ]
          },
          "verdict": {
            "enum": [
              "required",
              "informational"
            ]
          },
          "probeFrom": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/vantage"
            },
            "uniqueItems": true
          },
          "serviceTag": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9.]*$"
          },
          "note": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "fqdn",
                    "wildcard"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "host"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "host"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "wildcard"
                }
              }
            },
            "then": {
              "properties": {
                "probeFrom": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "views": {
      "type": "object",
      "required": [
        "browser",
        "device",
        "host",
        "notProbed"
      ],
      "additionalProperties": false,
      "description": "Row ids per vantage, so a reader filters nothing itself; notProbed lists rows no vantage probes, for a tool's 'not tested' list.",
      "properties": {
        "browser": {
          "$ref": "#/$defs/idList"
        },
        "device": {
          "$ref": "#/$defs/idList"
        },
        "host": {
          "$ref": "#/$defs/idList"
        },
        "notProbed": {
          "$ref": "#/$defs/idList"
        }
      }
    }
  }
}
