{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "avd-assess-index/v1: avd-assess's references and observations as one document (index.json)",
  "description": "Contract C20, generated by avd-assess from its references/*.yaml, observations/*.yaml and gaps/*.md and checked fresh by its CI, so readers need no YAML parser. A reference is a published source pinned to an immutable version, with the claims we take from it in our own words; an observation is what our own runs showed about one claim, with public evidence links. The source's text is never stored.",
  "type": "object",
  "required": [
    "schema",
    "references",
    "observations",
    "gaps"
  ],
  "additionalProperties": false,
  "$defs": {
    "line": {
      "type": "string",
      "minLength": 3,
      "maxLength": 400,
      "pattern": "^[^\\n\\r]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "claimRef": {
      "type": "string",
      "pattern": "^ref:[a-z0-9][a-z0-9-]{1,63}#[A-Za-z0-9][A-Za-z0-9.:-]{0,63}$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "avd-assess-index/v1"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "pin",
          "read",
          "license",
          "areas",
          "claims"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "$ref": "#/$defs/line"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "pin": {
            "type": "string",
            "description": "A GitHub blob or tree URL at a 40-character commit, or a Learn page's own git_commit_id and updated_at when its source repo is private",
            "pattern": "(^https://github\\.com/[^/]+/[^/]+/(blob|tree)/[0-9a-f]{40}(/|$)|^Learn git_commit_id [0-9a-f]{40}, updated_at [0-9]{4}-[0-9]{2}-[0-9]{2}$)"
          },
          "read": {
            "$ref": "#/$defs/date"
          },
          "license": {
            "$ref": "#/$defs/line"
          },
          "areas": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "collection",
                "assessment",
                "benchmarks",
                "scoring"
              ]
            }
          },
          "notes": {
            "$ref": "#/$defs/line"
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "says"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]{0,63}$",
                  "description": "The source's own public ID when it has one (a checklist short ID, an APRL ID), otherwise ours"
                },
                "says": {
                  "$ref": "#/$defs/line"
                },
                "kind": {
                  "enum": [
                    "published",
                    "prior",
                    "guidance"
                  ],
                  "description": "prior: the source itself calls it an estimate"
                }
              }
            }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "verdict",
          "observed",
          "evidence",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "claim": {
            "$ref": "#/$defs/claimRef"
          },
          "verdict": {
            "enum": [
              "agrees",
              "disagrees",
              "extends",
              "not-yet-tested"
            ]
          },
          "observed": {
            "type": "string",
            "minLength": 3,
            "maxLength": 800,
            "pattern": "^[^\\n\\r]+$"
          },
          "evidence": {
            "type": "array",
            "description": "Public family artifacts at a pinned commit: a lesson, a decision, a run record, a KB page",
            "items": {
              "type": "string",
              "pattern": "^https://github\\.com/[^/]+/[^/]+/(blob|tree)/[0-9a-f]{40}/"
            }
          },
          "date": {
            "$ref": "#/$defs/date"
          }
        },
        "if": {
          "properties": {
            "verdict": {
              "enum": [
                "agrees",
                "disagrees",
                "extends"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "evidence": {
              "minItems": 1
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "description": "avd-assess's gap files: method we wrote because no source covers it, each saying what was searched and not found",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "$ref": "#/$defs/line"
          }
        }
      }
    }
  }
}
