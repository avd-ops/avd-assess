{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assess.avd-ops.dev/schemas/avd-assess-map/v1.json",
  "title": "avd-assess-map/v1: the map of an AVD estate as one document (map.json)",
  "description": "Contract C20's third document, generated by avd-assess from pillars.yaml, dimensions.yaml, baselines.yaml, use-cases.yaml and gold-standards.yaml and checked fresh by its CI, so readers (the standards library, the brain) need no YAML parser. Every dimension row is one node of the map: what it decides, the pillar it belongs to, the upstream claims or gap that say what good is, the facts that measure it, the checks that judge it and the landing zone parameters that set it. The YAML files stay the authority; this is a view. Optional and additive: a reader that doesn't know a field ignores it.",
  "type": "object",
  "required": [
    "schema",
    "pillars",
    "landingZone",
    "dimensions",
    "baselines",
    "useCases",
    "goldStandards"
  ],
  "additionalProperties": false,
  "$defs": {
    "deprecated": {"type": "object", "description": "Marks an ID that a later major release may remove (docs/distribution-spec.md section 6): the release that first carried the mark and the ID that replaces it, if any. Readers keep using a deprecated ID until it is gone.", "required": ["since"], "additionalProperties": false, "properties": {"since": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}, "replacedBy": {"type": ["string", "null"]}}},
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"
    },
    "cite": {
      "type": "string",
      "pattern": "^(ref|obs|gap):[A-Za-z0-9._:#-]+$"
    },
    "factId": {
      "type": "string",
      "pattern": "^(proposed:)?[a-z][A-Za-z0-9.]+$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "avd-assess-map/v1"
    },
    "pillars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "scope", "status"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "deprecated": {"$ref": "#/$defs/deprecated"},
          "title": {"type": "string"},
          "scope": {"type": "string"},
          "method": {"type": "string"},
          "checklist": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["mapped", "partial", "missing", "extension"]}
        }
      }
    },
    "landingZone": {
      "type": "object",
      "required": ["commit", "source", "parameters"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source": {"type": "string", "pattern": "^https://"},
        "parameters": {"type": "array", "items": {"type": "string"}},
        "notDimensions": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "area", "pillar", "title", "decides", "home", "baseline", "measure", "landingZone"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "deprecated": {"$ref": "#/$defs/deprecated"},
          "area": {"type": "string"},
          "pillar": {"$ref": "#/$defs/slug"},
          "title": {"type": "string"},
          "decides": {"type": "string"},
          "home": {
            "type": "object",
            "properties": {
              "decision": {"$ref": "#/$defs/factId"},
              "facts": {"type": "array", "items": {"$ref": "#/$defs/factId"}},
              "intake": {"type": "array", "items": {"$ref": "#/$defs/factId"}},
              "checks": {"type": "array", "items": {"type": "string"}}
            }
          },
          "baseline": {
            "type": "object",
            "required": ["standing", "claims", "says"],
            "properties": {
              "standing": {"enum": ["published", "prior", "guidance", "gap", "owned"]},
              "claims": {"type": "array", "items": {"$ref": "#/$defs/cite"}},
              "says": {"type": "string"}
            }
          },
          "observations": {"type": "array", "items": {"$ref": "#/$defs/cite"}},
          "seeAlso": {"type": "string", "pattern": "^https://"},
          "measure": {"enum": ["fact", "rebuild", "measured", "intake", "host-side", "directory", "none"]},
          "landingZone": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    },
    "baselines": {
      "type": "object"
    },
    "useCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "title"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "deprecated": {"$ref": "#/$defs/deprecated"},
          "kind": {"enum": ["persona", "overlay"]},
          "title": {"type": "string"}
        }
      }
    },
    "goldStandards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "claim", "standing", "since", "why"],
        "properties": {
          "metric": {"type": "string"},
          "claim": {"$ref": "#/$defs/cite"},
          "standing": {"enum": ["candidate", "gold", "baseline", "demoted"]},
          "since": {"type": "string"},
          "why": {"type": "string"},
          "replaces": {"type": "string"}
        }
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "tier", "title", "summary", "harness", "metrics", "claims"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "deprecated": {"$ref": "#/$defs/deprecated"},
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "tier": {"enum": ["synthetic", "observational"]},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "harness": {"type": "string"},
          "parameters": {"type": "array", "items": {"type": "object"}},
          "metrics": {"type": "array", "items": {"type": "object"}},
          "claims": {"type": "array", "items": {"$ref": "#/$defs/cite"}},
          "observations": {"type": "array", "items": {"$ref": "#/$defs/cite"}}
        }
      }
    }
  }
}
